SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Comma-separated Slack member IDs allowed to count, approve and receive stock.
CUPBOARD_OWNER_IDS=
OFFICEWORKS_STATE=NSW
# Optional office postcode, e.g. 2000. Sent to Ollie as shopping context.
# Keep all four digits, including leading zeros (e.g. 0800 for NT).
OFFICEWORKS_POSTCODE=
# Optional Slack office-name mapping. Replace the examples with your office locations.
# OFFICE_LOCATIONS='{"Sydney":{"state":"NSW","postcode":"2000"},"Melbourne":{"state":"VIC","postcode":"3000"}}'
OFFICE_LOCATIONS={}
# Optional exact custom profile field ID. Blank auto-detects a unique visible
# field labelled Office, Location, or Office Location. Requires users.profile:read.
SLACK_OFFICE_FIELD_ID=
PORT=3000
DATA_FILE=./data/cupboard.json
# Buyer-accessible URL for approved order links. Defaults to http://localhost:PORT.
# Set to your HTTPS app/tunnel origin when the buyer uses another computer.
# Restart the app and refresh Slack App Home whenever this URL changes.
PUBLIC_BASE_URL=
